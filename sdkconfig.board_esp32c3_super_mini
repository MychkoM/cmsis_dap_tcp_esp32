# For the ESP32-C3 SuperMini board.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESP_UART_BRIDGE_1_REMAP_PINS=y
CONFIG_ESP_UART_BRIDGE_1_TXD_PIN=21
CONFIG_ESP_UART_BRIDGE_1_RXD_PIN=20
CONFIG_ESP_DAP_1_GPIO_SWCLK_TCK=0
CONFIG_ESP_DAP_1_GPIO_SWDIO_TMS=1
CONFIG_ESP_DAP_1_GPIO_TDI=9
CONFIG_ESP_DAP_1_GPIO_TDO=10
CONFIG_ESP_DAP_1_GPIO_NTRST=7
CONFIG_ESP_DAP_1_GPIO_NRESET=2
CONFIG_ESP_DAP_1_LED_STANDARD=y
CONFIG_ESP_DAP_1_LED_ACTIVE_LOW=y
CONFIG_ESP_DAP_1_GPIO_LED=8
CONFIG_ESP_DAP_PRODUCT_ID="CMSIS-DAP-TCP ESP32-C3 SuperMini"
CONFIG_ESP_DAP_IO_PORT_WRITE_CYCLES=16
CONFIG_ESP_DAP_DELAY_SLOW_CYCLES=7
# External MCU-219/INA219 module. SDA=GPIO3, SCL=GPIO4 (free/JTAG-only pins,
# boot-safe; strapping on C3 is only GPIO2/8/9).
CONFIG_ESP_INA219_SDA_PIN=3
CONFIG_ESP_INA219_SCL_PIN=4
CONFIG_ESP_INA219_SHUNT_MILLIOHMS=470
