# ESP32-C3 0.42 inch OLED board. OLED SDA=5/SCL=6; external INA219 SDA=5/SCL=6.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESP_UART_BRIDGE_1_REMAP_PINS=y
CONFIG_ESP_UART_BRIDGE_1_TXD_PIN=21
CONFIG_ESP_UART_BRIDGE_1_RXD_PIN=20
CONFIG_ESP_DAP_1_GPIO_SWCLK_TCK=0
CONFIG_ESP_DAP_1_GPIO_SWDIO_TMS=1
# CONFIG_ESP_DAP_1_JTAG_SUPPORTED is not set
CONFIG_ESP_DAP_1_GPIO_NRESET=2
CONFIG_ESP_DAP_1_LED_NONE=y
CONFIG_ESP_DAP_PRODUCT_ID="CMSIS-DAP-TCP ESP32-C3 OLED 0.42"
CONFIG_ESP_DAP_IO_PORT_WRITE_CYCLES=16
CONFIG_ESP_DAP_DELAY_SLOW_CYCLES=7
CONFIG_ESP_INA219_ENABLED=y
CONFIG_ESP_INA219_SDA_PIN=5
CONFIG_ESP_INA219_SCL_PIN=6
CONFIG_ESP_INA219_ADDRESS=0x40
CONFIG_ESP_INA219_SHUNT_MILLIOHMS=100
